{
  "name": "key-browser",
  "version": "1.0.0",
  "description": "A privacy-focused browser with maximum anonymity and security features",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "privacy",
    "browser",
    "anonymous",
    "security",
    "incognito"
  ],
  "author": "Key Browser Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.keybrowser.app",
    "productName": "Key",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ]
  }
}
